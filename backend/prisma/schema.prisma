generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String
  createdAt   DateTime     @default(now())
  workflows   Workflow[]
  credentials Credential[]
}

model Credential {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connector String   // 'discord' | 'gmail' | 'notion' | 'telegram'
  label     String
  data      String   // JSON chiffré AES-256
  createdAt DateTime @default(now())
  steps     Step[]
}

model Workflow {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  triggerType   String   // 'webhook' | 'cron' | 'gmail_poll' | 'form'
  triggerConfig Json
  webhookToken  String?  @unique
  active        Boolean  @default(true)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  steps         Step[]
  runs          Run[]
}

model Step {
  id           String      @id @default(uuid())
  workflowId   String
  workflow     Workflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  position     Int
  connector    String      // 'discord' | 'telegram' | 'gmail' | 'notion' | 'webhook' | 'delay'
  action       String      // 'send_message' | 'send_email' | 'create_page' | 'http_post' | 'wait'
  config       Json
  credentialId String?
  credential   Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  stepLogs     StepLog[]
}

model Run {
  id          String    @id @default(uuid())
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status      String    // 'running' | 'success' | 'failed' | 'partial'
  triggerData Json?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  stepLogs    StepLog[]
}

model StepLog {
  id         String   @id @default(uuid())
  runId      String
  run        Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId     String?
  step       Step?    @relation(fields: [stepId], references: [id], onDelete: SetNull)
  position   Int
  status     String   // 'success' | 'failed' | 'skipped'
  input      Json?
  output     Json?
  error      String?
  durationMs Int?
  executedAt DateTime @default(now())
}

# Serveur
PORT=3000
NODE_ENV=production

# Base de données (Supabase — utiliser l'URL "Transaction pooler" port 6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Redis (Render Redis interne ou Upstash)
REDIS_URL=redis://...

# JWT — générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Chiffrement AES-256 — 64 caractères hex (32 octets)
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# CORS — URL du frontend Vercel
FRONTEND_URL=https://ton-projet.vercel.app
